pid @WORK@/nginx.pid;
error_log @WORK@/nginx-error.log;
worker_processes 1;
events { worker_connections 128; }
http {
    access_log @WORK@/nginx-access.log;
    server {
        listen 80;
        server_name web.lab.test;
        location / { return 200 "Laboratory service\n"; }
    }
    server {
        listen 443 ssl;
        server_name web.lab.test;
        ssl_certificate @WORK@/server.crt;
        ssl_certificate_key @WORK@/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        location / { return 200 "Laboratory service\n"; }
    }
}
